{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "data/{f1_data.duckdb,corner_nicknames.json,research_cache/**}",
      "excludeFiles": "{frontend/**,backend/tests/**,.specify/**,data/fastf1_cache/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/((?!api/|health|docs|openapi.json).*)", "destination": "/index.html" }
  ]
}
